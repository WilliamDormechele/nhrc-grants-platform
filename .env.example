# NHRC Grants Platform local development settings
# Copy to .env and replace secret values locally. Never commit .env.

APP_ENV=development
APP_NAME=NHRC Grants Platform
APP_URL=http://localhost:3000
API_URL=http://localhost:8080
API_PORT=8080
AUTH_MODE=development

POSTGRES_DB=nhrc_grants
POSTGRES_USER=nhrc_grants
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_HOST=localhost
# 5436 avoids collision with other NHRC/local PostgreSQL services on the workstation.
POSTGRES_PORT=5436

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ISSUER=nhrc-grants
JWT_AUDIENCE=nhrc-grants-web
JWT_SECRET=CHANGE_ME_LOCAL_ONLY

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=grants@nhrc.example

FILE_STORAGE_PATH=.local/storage

# Optional live funding-source integration. Grants.gov search is keyless.
# Simpler.Grants.gov requires an API key for live searches.
SIMPLER_GRANTS_API_KEY=

# Automatic funding discovery. The scheduler checks due profiles once per hour by default.
# Set false to disable scheduled searches while keeping manual live search available.
GRANT_DISCOVERY_AUTO_ENABLED=true
GRANT_DISCOVERY_POLL_MS=3600000
