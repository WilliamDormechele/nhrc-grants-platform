# NHRC Grants Platform local development settings
# Copy to .env and replace values locally. Never commit .env.

APP_ENV=development
APP_NAME=NHRC Grants Platform
APP_URL=http://localhost:3000
API_URL=http://localhost:8080

POSTGRES_DB=nhrc_grants
POSTGRES_USER=nhrc_grants
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ISSUER=nhrc-grants
JWT_AUDIENCE=nhrc-grants-web
JWT_SECRET=CHANGE_ME_LOCAL_ONLY

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=grants@nhrc.example

FILE_STORAGE_PATH=.local/storage
